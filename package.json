{
  "name": "proxyfleet-webui-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --target windows/amd64 --target linux/amd64",
    "test:build": "node --test tests/build/build.test.mjs",
    "build:webui": "vite build webui",
    "dev:webui": "vite webui",
    "test:e2e": "playwright test",
    "check:webui": "tsc -p webui/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
